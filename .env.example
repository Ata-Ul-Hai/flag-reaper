# Reaper env (all optional — defaults work locally)
UNLEASH_URL=http://localhost:4242
UNLEASH_ADMIN_TOKEN=*:*.b8f8c6a1d2e34f5a9c7b0d8e1f2a3b4c5d6e7f8a9b0c1d2e
REAPER_REPO=/absolute/path/to/demo/checkout-service
REAPER_MCP_PORT=8900

# GitHub (fine-grained PAT: Contents + Pull requests write, NO merge scope)
GITHUB_REPO=Ata-Ul-Hai/flag-reaper-demo
GITHUB_TOKEN=
REAPER_REPO_SOURCE=https://github.com/Ata-Ul-Hai/flag-reaper-demo
